{# Datagrid of the admin lists (sidus_data_grid.default_theme), in the design system: filter bar, `.table`, `.pager`. It extends the
   bundle's unstyled layout and overrides the blocks it renders differently.
   Variables: datagrid, admin, action (+ what a screen's ListAction adds). The whole grid is ONE GET form: filters, sort buttons
   (a column head that sorts is a submit button of the form) and the hidden current sort. The row actions are plain links, never
   forms (no form inside a form); destructive ones lead to a confirmation page. Page links carry the filters and the current sort
   (`datagrid.query`) but never a sort button, otherwise changing page would flip the order again. #}
{% extends '@SidusDataGrid/datagrid/base.html.twig' %}

{% block datagrid %}
    {% set form = datagrid.formView %}
    {% set pager = datagrid.pager %}
    {{ form_start(form, {attr: {class: 'datagrid'}}) }}
        {{ form_errors(form) }}
        {{ form_errors(form.page) }}
        {% if datagrid.hasFilters %}
            <div class="filter-bar" role="search" aria-label="{{ 'admin.list.filters'|trans }}">
                <div class="filter-bar-fields">
                    {% for filter in datagrid.filterViews %}
                        {% if filter.from is defined and filter.to is defined %}
                            <div class="field filter-range" role="group" aria-labelledby="{{ filter.vars.id }}_label">
                                <span class="label" id="{{ filter.vars.id }}_label">{{ (filter.vars.label ?: filter.vars.name|humanize)|trans }}</span>
                                <div class="filter-range-inputs">
                                    {{ form_widget(filter.from, {attr: {'aria-label': ((filter.vars.label ?: filter.vars.name|humanize)|trans) ~ ' : ' ~ ('admin.list.date_from'|trans), placeholder: ''}}) }}
                                    <span aria-hidden="true">–</span>
                                    {{ form_widget(filter.to, {attr: {'aria-label': ((filter.vars.label ?: filter.vars.name|humanize)|trans) ~ ' : ' ~ ('admin.list.date_to'|trans), placeholder: ''}}) }}
                                </div>
                                {{ form_errors(filter) }}
                            </div>
                        {% else %}
                            <div class="field">
                                {{ form_label(filter) }}
                                {{ form_widget(filter) }}
                                {{ form_errors(filter) }}
                            </div>
                        {% endif %}
                    {% endfor %}
                </div>
                <div class="filter-bar-actions">
                    <button type="submit" class="btn btn-secondary btn-sm">{{ 'admin.list.filter'|trans }}</button>
                    <a href="{{ action_url(datagrid.reset) }}" class="btn btn-ghost btn-sm">{{ 'admin.list.reset'|trans }}</a>
                </div>
            </div>
        {% endif %}

        <p class="list-meta" role="status">
            <span>{{ 'admin.list.count'|trans({'%count%': datagrid.result.total}) }}</span>
            {% if pager.nbPages > 1 %}<span>{{ 'admin.list.page'|trans({'%page%': pager.currentPage, '%pages%': pager.nbPages}) }}</span>{% endif %}
        </p>

        {{ block('datagrid_table') }}
    {{ form_end(form, {render_rest: false}) }}

    {{ block('datagrid_pagination') }}
{% endblock %}

{# the hidden current sort (kept when the filters are submitted) comes first, the sort buttons of the heads win over it #}
{% block datagrid_table %}
    <div class="table-responsive">
        {{ parent() }}
    </div>
{% endblock %}

{% block class_table %}table table-striped table-hover{% endblock %}

{% block datagrid_header_cell %}
    {%- set sort = datagrid.sortState(column) -%}
    <th{{ attributes(column.attributes, {scope: 'col', 'aria-sort': sort and sort.primary ? (sort.direction == 'asc' ? 'ascending' : 'descending') : null}) }}>
        {%- if sort -%}
            <button type="submit" class="table-sort" name="{{ datagrid.sortView.vars.full_name }}" value="{{ sort.next }}">{{ column.renderLabel }}</button>
        {%- else -%}
            {{ column.renderLabel }}
        {%- endif -%}
    </th>
{% endblock %}

{% block datagrid_table_body %}
    <tbody>
        {%- for result in datagrid.result.items -%}
            {{ block('datagrid_row') }}
        {%- else -%}
            <tr><td colspan="{{ datagrid.columns|length }}" class="table-empty">{{ 'admin.list.empty'|trans }}</td></tr>
        {%- endfor -%}
    </tbody>
{% endblock %}

{% block datagrid_pagination %}
    {% import '_ui/icons.html.twig' as ui %}
    {% set pager = datagrid.pager %}
    {% if pager.nbPages > 1 %}
        {% set current = pager.currentPage %}
        {% set last = pager.nbPages %}
        <nav class="pager my-8" aria-label="Pagination">
            {% if pager.hasPreviousPage %}
                <a href="{{ page_path(current - 1, datagrid.query) }}" rel="prev" aria-label="Page précédente">{{ ui.icon('chevron-left', 'size-4') }}</a>
            {% else %}
                <span class="is-disabled" aria-hidden="true">{{ ui.icon('chevron-left', 'size-4') }}</span>
            {% endif %}

            {% for item in range(1, last) %}
                {% if item == 1 or item == last or (item >= current - 2 and item <= current + 2) %}
                    {% if item == current %}
                        <span class="is-current" aria-current="page">{{ item }}</span>
                    {% else %}
                        <a href="{{ page_path(item, datagrid.query) }}">{{ item }}</a>
                    {% endif %}
                {% elseif item == current - 3 or item == current + 3 %}
                    <span aria-hidden="true">…</span>
                {% endif %}
            {% endfor %}

            {% if pager.hasNextPage %}
                <a href="{{ page_path(current + 1, datagrid.query) }}" rel="next" aria-label="Page suivante">{{ ui.icon('chevron-right', 'size-4') }}</a>
            {% else %}
                <span class="is-disabled" aria-hidden="true">{{ ui.icon('chevron-right', 'size-4') }}</span>
            {% endif %}
        </nav>
    {% endif %}
{% endblock %}
