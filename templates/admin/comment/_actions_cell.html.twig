{# Datagrid cell: view (the message on the forum) and delete (confirmation page). #}
<a href="{{ path('comment_show', {id: result.id}) }}" class="btn btn-ghost btn-sm" aria-label="{{ 'admin.action.view_for'|trans({'%name%': '#' ~ result.id}) }}">{{ 'admin.action.view'|trans }}</a>
<a href="{{ admin_entity_path(admin, result, 'delete') }}" class="btn btn-ghost btn-sm" aria-label="{{ 'admin.action.delete_for'|trans({'%name%': '#' ~ result.id}) }}">{{ 'admin.action.delete'|trans }}</a>
