{% extends 'admin/base.html.twig' %}

{% block title %}Administration · ComTSo{% endblock %}

{% import '_ui/icons.html.twig' as ui %}
{# One icon per screen (code of sidus.yaml => icon of _ui/icons.html.twig). #}
{% set icons = {user: 'users', forum: 'folder', topic: 'file-text', comment: 'message-square', photo: 'image', quote: 'quote'} %}

{% block container %}
<header class="page-header">
    <p class="kicker">Administration</p>
    <h1 class="page-title">Vue d’ensemble</h1>
    <p class="standfirst">Réservé aux administrateurs. Seuls les écrans des membres montrent les adresses e-mail.</p>
</header>

{% if screens is empty %}
    <p class="empty">Aucun écran d’administration n’est configuré.</p>
{% else %}
    <div class="admin-tiles">
        {% for screen in screens %}
            {% set code = screen.admin.code %}
            <a href="{{ admin_path(screen.admin, 'list') }}" class="card card-hover admin-tile">
                <span class="admin-tile-icon">{{ ui.icon(icons[code]|default('file-text'), 'size-6') }}</span>
                <div class="admin-tile-body">
                    <h2 class="card-title">{{ ('admin.' ~ code ~ '.title')|trans }}</h2>
                    <span class="badge badge-count">{{ screen.count|number_format(0, ',', ' ') }}</span>
                </div>
            </a>
        {% endfor %}
    </div>
{% endif %}
{% endblock %}
