{# Read-only facts above the user form. No e-mail address on purpose. #}
<dl class="dl mb-6">
    <dt>Pseudo</dt><dd>{{ data.username }}</dd>
    {% if data.name or data.surname %}<dt>Nom</dt><dd>{{ data.name }} {{ data.surname }}</dd>{% endif %}
    <dt>Inscription</dt><dd>{{ data.registeredAt ? data.registeredAt|date('d/m/Y') : '—' }}</dd>
    <dt>Dernière connexion</dt><dd>{{ data.lastLogin ? data.lastLogin|date('d/m/Y H:i') : '—' }}</dd>
    <dt>Dernière activité</dt><dd>{{ data.lastActivity ? data.lastActivity|date('d/m/Y H:i') : '—' }}</dd>
</dl>
