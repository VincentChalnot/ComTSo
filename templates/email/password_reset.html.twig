{% extends 'email/base.html.twig' %}
{% import 'email/_macros.html.twig' as m %}

{# Context: username, link (absolute, signed), lifetime_minutes. #}
{% block preheader %}Choisissez un nouveau mot de passe : le lien est valable {{ lifetime_minutes }} minutes.{% endblock %}

{% block content %}
  {{ m.heading('Nouveau mot de passe') }}
  {{ m.paragraph('Bonjour ' ~ username ~ ',') }}
  {{ m.paragraph('Une réinitialisation du mot de passe de votre compte ' ~ app_name ~ ' a été demandée.') }}
  {{ m.button('Choisir un nouveau mot de passe', link) }}
  {{ m.paragraph('Ce lien est valable ' ~ lifetime_minutes ~ ' minutes et ne peut servir qu’une seule fois. S’il ne s’ouvre pas, copiez cette adresse dans votre navigateur :', true) }}
  {{ m.link_line(link) }}
  {{ m.divider() }}
  {{ m.paragraph('Si vous n’êtes pas à l’origine de cette demande, ignorez simplement ce message : votre mot de passe actuel reste valable.', true) }}
{% endblock %}
