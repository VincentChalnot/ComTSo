{% extends 'base.html.twig' %}
{% import '_ui/avatar.html.twig' as av %}
{% import '_ui/photo.html.twig' as ph %}

{% block title %}Recherche{% if term %} « {{ term }} »{% endif %} · ComTSo{% endblock %}

{% block body %}
<header class="page-header">
    <p class="kicker">Recherche</p>
    <h1 class="page-title">{% if term %}Résultats pour « {{ term }} »{% else %}Recherche{% endif %}</h1>
    {% if results is null %}
        <p class="standfirst">Saisissez au moins deux caractères dans la barre de recherche.</p>
    {% else %}
        {% set total = 0 %}{% set capped = false %}
        {% for list in results %}{% set total = total + list|length %}{% set capped = capped or list|length >= limit %}{% endfor %}
        <p class="standfirst">
            {% if total == 0 %}Rien ne correspond à cette recherche.{% else %}{{ capped ? 'Plus de ' : '' }}{{ total }} résultat{{ total > 1 ? 's' : '' }} dans les messages, sujets, photos, chats, membres et citations.{% endif %}
        </p>
    {% endif %}
</header>

{% if results is not null %}
    {% set sections = [
        {key: 'comments', label: 'Messages'}, {key: 'topics', label: 'Sujets'}, {key: 'photos', label: 'Photos'},
        {key: 'chat', label: 'Chat'}, {key: 'people', label: 'Membres'}, {key: 'quotes', label: 'Citations'},
    ] %}
    <nav class="nav-pills -ml-3" aria-label="Accès rapide aux résultats">
        {% for section in sections %}
            <a href="#r-{{ section.key }}">{{ section.label }} <span class="badge badge-count{{ results[section.key]|length ? '' : ' badge-muted' }}">{{ results[section.key]|length }}{{ results[section.key]|length >= limit ? '+' : '' }}</span></a>
        {% endfor %}
    </nav>

    <section class="section" id="r-comments" aria-labelledby="t-comments">
        <h2 class="section-title" id="t-comments">Messages</h2>
        {% if results.comments %}
            <ol class="result-list">
                {% for comment in results.comments %}
                    <li class="result has-avatar">
                        <span class="result-aside">{{ av.avatar(comment.author, 'md') }}</span>
                        <div class="result-body">
                            <p class="kicker is-plain">{{ comment.topic.forum.title }}</p>
                            <h3 class="result-title"><a href="{{ path('topic_show', {forumId: comment.topic.forum.id, id: comment.topic.id}) }}">{{ comment.topic.title }}</a></h3>
                            <p class="result-excerpt">{{ comment.content|excerpt(term) }}</p>
                            <p class="byline">
                                <span>{{ comment.author ? comment.author.username : 'Ancien membre' }}</span>
                                <time datetime="{{ comment.createdAt|date('c') }}">{{ comment.createdAt|date('d/m/Y à H:i') }}</time>
                                <a href="{{ path('comment_show', {id: comment.id}) }}">Voir le message</a>
                            </p>
                        </div>
                    </li>
                {% endfor %}
            </ol>
        {% else %}
            <div class="empty empty-sm"><p class="empty-text">Aucun message.</p></div>
        {% endif %}
    </section>

    <section class="section" id="r-topics" aria-labelledby="t-topics">
        <h2 class="section-title" id="t-topics">Sujets</h2>
        {% if results.topics %}
            <ol class="result-list">
                {% for topic in results.topics %}
                    <li class="result">
                        <div class="result-body">
                            <p class="kicker is-plain">{{ topic.forum.title }}</p>
                            <h3 class="result-title"><a href="{{ path('topic_show', {forumId: topic.forum.id, id: topic.id}) }}">{{ topic.title }}</a></h3>
                            <p class="byline"><time datetime="{{ topic.createdAt|date('c') }}">{{ topic.createdAt|date('d/m/Y') }}</time></p>
                        </div>
                    </li>
                {% endfor %}
            </ol>
        {% else %}
            <div class="empty empty-sm"><p class="empty-text">Aucun sujet.</p></div>
        {% endif %}
    </section>

    <section class="section" id="r-photos" aria-labelledby="t-photos">
        <h2 class="section-title" id="t-photos">Photos</h2>
        {% if results.photos %}
            <div class="photo-grid">
                {% for photo in results.photos %}{{ ph.thumb(photo, 'search', 'aspect-square w-full') }}{% endfor %}
            </div>
        {% else %}
            <div class="empty empty-sm"><p class="empty-text">Aucune photo.</p></div>
        {% endif %}
    </section>

    <section class="section" id="r-chat" aria-labelledby="t-chat">
        <h2 class="section-title" id="t-chat">Chat</h2>
        {% if results.chat %}
            <ol class="result-list">
                {% for message in results.chat %}
                    <li class="result">
                        <div class="result-body">
                            <p class="byline">
                                <span>{{ message.author ? message.author.username : 'Ancien membre' }}</span>
                                <time datetime="{{ message.createdAt|date('c') }}">{{ message.createdAt|date('d/m/Y à H:i') }}</time>
                            </p>
                            <p class="result-excerpt">{{ message.content|excerpt(term, 200) }}</p>
                        </div>
                    </li>
                {% endfor %}
            </ol>
        {% else %}
            <div class="empty empty-sm"><p class="empty-text">Aucun message de chat.</p></div>
        {% endif %}
    </section>

    <section class="section" id="r-people" aria-labelledby="t-people">
        <h2 class="section-title" id="t-people">Membres</h2>
        {% if results.people %}
            <ol class="result-list">
                {% for person in results.people %}
                    <li class="result has-avatar">
                        <a class="result-aside" href="{{ path('people_show', {username: person.username}) }}" tabindex="-1" aria-hidden="true">{{ av.avatar(person, 'md') }}</a>
                        <div class="result-body">
                            <h3 class="result-title"><a href="{{ path('people_show', {username: person.username}) }}">{{ person.username }}</a></h3>
                            {% if person.name or person.surname %}<p class="byline"><span>{{ person.name }} {{ person.surname }}</span></p>{% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ol>
        {% else %}
            <div class="empty empty-sm"><p class="empty-text">Aucun membre.</p></div>
        {% endif %}
    </section>

    <section class="section" id="r-quotes" aria-labelledby="t-quotes">
        <h2 class="section-title" id="t-quotes">Citations</h2>
        {% if results.quotes %}
            <ol class="result-list">
                {% for quote in results.quotes %}
                    <li class="result">
                        <div class="result-body">
                            <p class="result-excerpt is-quote">{{ quote.content|excerpt(term, 300) }}</p>
                            {% if quote.originalAuthor %}<p class="byline"><span>{{ quote.originalAuthor }}</span></p>{% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ol>
        {% else %}
            <div class="empty empty-sm"><p class="empty-text">Aucune citation.</p></div>
        {% endif %}
    </section>
{% endif %}
{% endblock %}
