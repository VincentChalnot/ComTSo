{% extends 'base.html.twig' %}
{% import '_ui/avatar.html.twig' as av %}
{% import '_ui/photo.html.twig' as ph %}

{% block title %}Recherche{% if term %} « {{ term }} »{% endif %} · ComTSo{% endblock %}

{% block body %}
<header class="page-header">
    <p class="kicker">Recherche</p>
    <h1 class="page-title">{% if term %}Résultats pour « {{ term }} »{% else %}Recherche{% endif %}</h1>
    {% if not searched %}
        <p class="standfirst">Saisissez au moins deux caractères dans la barre de recherche.</p>
    {% else %}
        <p class="standfirst">
            {% if total == 0 %}Rien ne correspond à cette recherche.{% else %}{{ total|number_format(0, ',', ' ') }} résultat{{ total > 1 ? 's' : '' }} dans les messages, sujets, photos, chats, membres et citations.{% endif %}
        </p>
    {% endif %}
</header>

{% if searched %}
    <nav class="tabs" aria-label="Types de résultats">
        {% for key, definition in tabs %}
            <a href="{{ path('search', {q: term, tab: key}) }}"{% if key == tab %} aria-current="page"{% endif %}>{{ definition.label }} <span class="badge badge-count{{ counts[key] ? '' : ' badge-muted' }}">{{ counts[key]|number_format(0, ',', ' ') }}<span class="sr-only"> résultat{{ counts[key] > 1 ? 's' : '' }}</span></span></a>
        {% endfor %}
    </nav>

    <section class="section" aria-labelledby="results-title">
        <h2 class="section-title" id="results-title">{{ tabs[tab].label }}{% if pager.pageCount > 1 %} <span class="byline">page {{ pager.page }} sur {{ pager.pageCount }}</span>{% endif %}</h2>

        {% if items is empty %}
            <div class="empty empty-sm"><p class="empty-text">{{ tabs[tab].empty }}</p></div>
        {% elseif tab == 'comments' %}
            <ol class="result-list">
                {% for comment in items %}
                    <li class="result has-avatar">
                        <span class="result-aside">{{ av.avatar(comment.author, 'md') }}</span>
                        <div class="result-body">
                            <p class="kicker is-plain">{{ comment.topic.forum.title }}</p>
                            <h3 class="result-title"><a href="{{ path('topic_show', {forumId: comment.topic.forum.id, id: comment.topic.id}) }}">{{ comment.topic.title }}</a></h3>
                            <p class="result-excerpt">{{ comment.content|excerpt(term) }}</p>
                            <p class="byline">
                                <span>{{ comment.author ? comment.author.username : 'Ancien membre' }}</span>
                                <time datetime="{{ comment.createdAt|date('c') }}">{{ comment.createdAt|date('d/m/Y à H:i') }}</time>
                                <a href="{{ path('comment_show', {id: comment.id}) }}">Voir le message</a>
                            </p>
                        </div>
                    </li>
                {% endfor %}
            </ol>
        {% elseif tab == 'topics' %}
            <ol class="result-list">
                {% for topic in items %}
                    <li class="result">
                        <div class="result-body">
                            <p class="kicker is-plain">{{ topic.forum.title }}</p>
                            <h3 class="result-title"><a href="{{ path('topic_show', {forumId: topic.forum.id, id: topic.id}) }}">{{ topic.title }}</a></h3>
                            <p class="byline"><time datetime="{{ topic.createdAt|date('c') }}">{{ topic.createdAt|date('d/m/Y') }}</time></p>
                        </div>
                    </li>
                {% endfor %}
            </ol>
        {% elseif tab == 'photos' %}
            <div class="photo-grid">
                {% for photo in items %}{{ ph.thumb(photo, 'search', 'aspect-square w-full') }}{% endfor %}
            </div>
        {% elseif tab == 'chat' %}
            <ol class="result-list">
                {% for message in items %}
                    <li class="result">
                        <div class="result-body">
                            <p class="byline">
                                <span>{{ message.author ? message.author.username : 'Ancien membre' }}</span>
                                <time datetime="{{ message.createdAt|date('c') }}">{{ message.createdAt|date('d/m/Y à H:i') }}</time>
                            </p>
                            <p class="result-excerpt">{{ message.content|excerpt(term, 200) }}</p>
                        </div>
                    </li>
                {% endfor %}
            </ol>
        {% elseif tab == 'people' %}
            <ol class="result-list">
                {% for person in items %}
                    <li class="result has-avatar">
                        <a class="result-aside" href="{{ path('people_show', {username: person.username}) }}" tabindex="-1" aria-hidden="true">{{ av.avatar(person, 'md') }}</a>
                        <div class="result-body">
                            <h3 class="result-title"><a href="{{ path('people_show', {username: person.username}) }}">{{ person.username }}</a></h3>
                            {% if person.name or person.surname %}<p class="byline"><span>{{ person.name }} {{ person.surname }}</span></p>{% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ol>
        {% else %}
            <ol class="result-list">
                {% for quote in items %}
                    <li class="result">
                        <div class="result-body">
                            <p class="result-excerpt is-quote">{{ quote.content|excerpt(term, 300) }}</p>
                            {% if quote.originalAuthor %}<p class="byline"><span>{{ quote.originalAuthor }}</span></p>{% endif %}
                        </div>
                    </li>
                {% endfor %}
            </ol>
        {% endif %}
    </section>

    {% include '_layout/pagination.html.twig' with {pager: pager, route: 'search', params: {q: term, tab: tab}} %}
{% endif %}
{% endblock %}
