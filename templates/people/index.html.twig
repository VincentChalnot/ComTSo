{% extends 'base.html.twig' %}
{% import '_ui/avatar.html.twig' as av %}

{% block title %}Les gens · ComTSo{% endblock %}

{% block body %}
<header class="page-header">
    <p class="kicker">Le cercle</p>
    <h1 class="page-title">Les gens</h1>
    <p class="standfirst">{{ people|length }} membre{{ people|length > 1 ? 's' : '' }} du cercle, depuis 2004.</p>
</header>

<div class="people-grid">
    {% for person in people %}
        <a href="{{ path('people_show', {username: person.username}) }}" class="card card-hover person-card">
            <span class="person-card-avatar">
                {{ av.avatar(person, 'xl') }}
                {% if unread_messages()[person.id] is defined %}
                    <span class="badge badge-accent badge-count person-card-count" title="Messages privés non lus">{{ unread_messages()[person.id] }}<span class="sr-only"> messages privés non lus</span></span>
                {% endif %}
            </span>
            <span class="person-card-name">{{ person.username }}</span>
            {% if person.name or person.surname %}<span class="person-card-meta">{{ person.name }} {{ person.surname }}</span>{% endif %}
        </a>
    {% endfor %}
</div>
{% endblock %}
