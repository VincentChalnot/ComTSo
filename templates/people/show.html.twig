{% extends 'base.html.twig' %}
{% import '_ui/icons.html.twig' as ui %}
{% import '_ui/avatar.html.twig' as av %}

{% block title %}{{ person.username }} · ComTSo{% endblock %}

{% block body %}
{% set fullName = (person.name ~ ' ' ~ person.surname)|trim %}
<section class="profile card" aria-labelledby="profile-name">
    <header class="profile-header">
        {{ av.avatar(person, 'xl', 'profile-avatar') }}
        <div class="profile-identity">
            <p class="kicker">{{ isMe ? 'Votre fiche' : 'Membre du cercle' }}</p>
            <h1 class="profile-name" id="profile-name">{{ fullName ?: person.username }}</h1>
            {% if fullName %}<p class="profile-username">{{ person.username }}</p>{% endif %}
        </div>
        {% if person.signature %}<div class="profile-signature post-body">{{ person.signature|rich_text }}</div>{% endif %}
    </header>

    <dl class="dl profile-details">
        {% if person.email %}<dt>Email</dt><dd><a href="mailto:{{ person.email }}">{{ person.email }}</a></dd>{% endif %}
        {% if person.website %}<dt>Site web</dt><dd><a href="{{ person.website }}" target="_blank" rel="noopener noreferrer">{{ person.website }}</a></dd>{% endif %}
        {% if person.activities %}<dt>Activités</dt><dd>{{ person.activities|e|nl2br }}</dd>{% endif %}
        {% if person.birthday %}<dt>Né(e) le</dt><dd>{{ person.birthday|date('d/m/Y') }} ({{ date().diff(person.birthday).y }} ans)</dd>{% endif %}
        <dt>Inscrit le</dt><dd>{{ person.registeredAt|date('d/m/Y') }}</dd>
        {% if person.phone %}<dt>Téléphone</dt><dd>{{ person.phone }}</dd>{% endif %}
        {% if person.address %}<dt>Adresse</dt><dd>{{ person.address|e|nl2br }}</dd>{% endif %}
    </dl>

    {% if isMe or is_granted('ROLE_ADMIN') %}
        <div class="profile-actions">
            <a href="{{ path('people_edit', {username: person.username}) }}" class="btn">{{ ui.icon('pencil', 'size-4') }} Modifier le profil</a>
            <a href="{{ path('people_config', {username: person.username}) }}" class="btn">{{ ui.icon('settings', 'size-4') }} Configuration</a>
        </div>
    {% endif %}
</section>

<section class="section" aria-labelledby="conversation">
    <h2 id="conversation" class="section-title">{{ isMe ? 'Mes mémos' : 'Messages privés' }}</h2>

    {{ form_start(form) }}
        <div class="reply">
            <span class="reply-avatar">{{ av.avatar(app.user, 'md') }}</span>
            <div class="reply-body">
                <p class="card-title mb-2">{{ isMe ? 'Nouveau mémo' : 'Écrire à ' ~ person.username }}</p>
                {{ form_row(form.content) }}
            </div>
            <div class="reply-actions"><button type="submit" class="btn btn-primary">{{ ui.icon('send', 'size-4') }} Envoyer</button></div>
        </div>
    {{ form_end(form) }}

    <div class="mt-10 border-y border-line">
        {% for message in conversation %}
            <article class="post" id="message-{{ message.id }}" data-post>
                {% if message.author %}
                    <a href="{{ path('people_show', {username: message.author.username}) }}" class="shrink-0 self-start" title="{{ message.author.username }}">{{ av.avatar(message.author, 'md') }}</a>
                {% else %}
                    <span class="shrink-0 self-start">{{ av.avatar(null, 'md') }}</span>
                {% endif %}
                <div class="min-w-0 flex-1">
                    <p class="post-author">{{ message.author ? message.author.username : 'Ancien membre' }} <time class="post-author-sub" datetime="{{ message.createdAt|date('c') }}">{{ message.createdAt|date('d/m/Y à H:i') }}</time></p>
                    <div class="post-body" data-collapsible>{{ message.content|rich_text }}</div>
                </div>
            </article>
        {% else %}
            <div class="empty empty-sm is-plain"><p class="empty-text">{{ isMe ? 'Aucun mémo pour le moment.' : 'Aucun message privé échangé avec ' ~ person.username ~ '.' }}</p></div>
        {% endfor %}
    </div>
</section>
{% endblock %}
