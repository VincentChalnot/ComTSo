{% extends 'base.html.twig' %}

{% block title %}Modifier le profil · ComTSo{% endblock %}

{% block body %}
<header class="page-header">
    <p class="kicker"><a href="{{ path('people_show', {username: person.username}) }}">{{ person.username }}</a></p>
    <h1 class="page-title">Modifier le profil</h1>
    <p class="standfirst">Ce que les autres membres voient sur votre fiche.</p>
</header>

<div class="settings">
    <div class="card card-roomy">
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <div class="form-actions">
                <a href="{{ path('people_show', {username: person.username}) }}" class="btn">Annuler</a>
                <button type="submit" class="btn btn-primary">Enregistrer</button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
