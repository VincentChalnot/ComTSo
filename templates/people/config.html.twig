{% extends 'base.html.twig' %}

{% block title %}Configuration · ComTSo{% endblock %}

{% block body %}
<h1 class="mb-4 text-2xl font-bold tracking-tight">Configuration</h1>
<div class="card max-w-xl p-5">
    {{ form_start(form) }}
        {{ form_row(form.message_order) }}
        <p class="mb-4 text-sm text-muted">Le thème clair / sombre se change avec le bouton ☀︎ / ☾ de la barre de navigation.</p>
        <button type="submit" class="btn btn-primary">Sauvegarder</button>
    {{ form_end(form) }}
</div>
{% endblock %}
