{% extends 'base.html.twig' %}
{% import '_ui/avatar.html.twig' as av %}

{% block title %}Configuration · ComTSo{% endblock %}

{% block body %}
<header class="page-header">
    <p class="kicker"><a href="{{ path('people_show', {username: person.username}) }}">{{ person.username }}</a></p>
    <h1 class="page-title">Configuration</h1>
    <p class="standfirst">Quelques réglages de lecture, propres à votre compte.</p>
</header>

<div class="settings">
    <div class="card card-roomy">
        {{ form_start(form) }}
            {{ form_row(form.message_order) }}
            <p class="settings-hint">Le thème clair / sombre se change avec le bouton ☀︎ / ☾ de la barre de navigation.</p>
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Sauvegarder</button>
            </div>
        {{ form_end(form) }}
    </div>

    {% if avatarForm %}
        <div class="card card-roomy mt-6" id="avatar">
            <h2 class="section-title">Avatar</h2>
            <div class="flex items-center gap-4 mb-5">
                {{ av.avatar(person, 'xl') }}
                <p class="settings-hint mb-0">{{ person.avatar ? 'Voici votre avatar actuel.' : 'Vous n\'avez pas d\'avatar : votre initiale s\'affiche à la place.' }}</p>
            </div>
            {{ form_start(avatarForm) }}
                {{ form_row(avatarForm.file) }}
                <div class="form-actions">
                    {% if avatarForm.remove is defined %}{{ form_widget(avatarForm.remove) }}{% endif %}
                    {{ form_widget(avatarForm.upload) }}
                </div>
            {{ form_end(avatarForm) }}
        </div>
    {% endif %}

    {% if passwordForm %}
        <div class="card card-roomy mt-6" id="mot-de-passe">
            <h2 class="section-title">Mot de passe</h2>
            <p class="settings-hint">Après le changement, les autres appareils devront se reconnecter.</p>
            {{ form_start(passwordForm) }}
                {{ form_widget(passwordForm) }}
                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Changer le mot de passe</button>
                </div>
            {{ form_end(passwordForm) }}
        </div>
    {% endif %}
</div>
{% endblock %}
