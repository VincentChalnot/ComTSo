{% extends 'settings/_layout.html.twig' %}

{% block title %}Profil · Paramètres · ComTSo{% endblock %}
{% block settings_title %}Profil{% endblock %}
{% block settings_intro %}Ce que les autres membres voient sur votre fiche.{% endblock %}

{% block settings_body %}
<div class="settings">
    <div class="card card-roomy">
        {{ form_start(form) }}
            {{ form_widget(form) }}
            <div class="form-actions">
                <a href="{{ path('people_show', {username: person.username}) }}" class="btn">Annuler</a>
                <button type="submit" class="btn btn-primary">Enregistrer</button>
            </div>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
