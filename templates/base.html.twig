{% import '_ui/icons.html.twig' as ui %}
{% import '_ui/avatar.html.twig' as av %}
{% set route = app.current_route ?? '' %}
{% set nav_links = [
    {route: 'app_home', label: 'Accueil', match: ['app_home']},
    {route: 'forum_index', label: 'Forums', match: ['forum_index', 'forum_show', 'topic_show', 'topic_edit', 'topic_photos', 'comment_show', 'comment_edit', 'forum_new_topic']},
    {route: 'people_index', label: 'Les gens', match: ['people_index', 'people_show', 'people_edit']},
    {route: 'photo_index', label: 'Photos', match: ['photo_index', 'photo_show', 'photo_edit']},
] %}
<!DOCTYPE html>
<html lang="fr" data-theme="{{ app.user ? app.user.theme : 'light' }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>{% block title %}ComTSo{% endblock %}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    {% if not app.user %}
        {# Anonymous visitors: the choice saved by the login-page toggle (localStorage), else the OS preference. Before the stylesheet: no flash. #}
        <script>(function(){var t=null;try{t=localStorage.getItem('comtso-theme')}catch(e){}document.documentElement.dataset.theme=t||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light')})();</script>
    {% endif %}
    {% block stylesheets %}<link rel="stylesheet" href="/assets/main.css">{% endblock %}
</head>
<body class="{% block body_class %}{% endblock %}">
    <a class="skip-link" href="#main">Aller au contenu</a>

    {% block masthead %}
    <header class="masthead">
        <div class="masthead-bar">
            {% if app.user %}
                <form action="{{ path('search') }}" method="get" role="search" class="masthead-search">
                    <label for="masthead-q" class="sr-only">Rechercher</label>
                    <div class="input-wrap">
                        <span class="input-icon">{{ ui.icon('search', 'size-4') }}</span>
                        <input type="search" id="masthead-q" name="q" value="{{ app.request.query.get('q') }}" placeholder="Rechercher…" class="input has-icon">
                    </div>
                </form>
            {% endif %}

            <a href="{{ path('app_home') }}" class="masthead-title">ComTSo<small>Depuis 2004</small></a>

            {% if app.user %}
                <div class="masthead-tools">
                    <div data-vue-component="ThemeToggle" data-props="{{ {url: path('user_theme'), csrf: csrf_token('theme')}|json_encode|e('html_attr') }}"></div>
                    <a href="{{ path('people_config', {username: app.user.username}) }}" class="btn-icon masthead-settings" title="Configuration" aria-label="Configuration">{{ ui.icon('settings', 'size-5') }}</a>
                    <a href="{{ path('people_show', {username: app.user.username}) }}" class="masthead-user" title="Mon profil">
                        {{ av.avatar(app.user, 'sm') }}<span class="masthead-user-name">{{ app.user.username }}</span>
                    </a>
                    <a href="{{ logout_path() }}" class="btn-icon masthead-logout" title="Déconnexion" aria-label="Déconnexion">{{ ui.icon('log-out', 'size-5') }}</a>
                </div>
            {% endif %}
        </div>

        {% if app.user %}
            <nav class="masthead-nav" aria-label="Navigation principale">
                <button type="button" class="btn-icon masthead-toggle" data-nav-toggle aria-label="Menu" aria-expanded="false" aria-controls="nav-menu">{{ ui.icon('menu', 'size-5') }}</button>
                <ul id="nav-menu" class="masthead-menu" data-nav-menu>
                    <li class="masthead-menu-search">
                        <form action="{{ path('search') }}" method="get" role="search">
                            <label for="menu-q" class="sr-only">Rechercher</label>
                            <div class="input-wrap">
                                <span class="input-icon">{{ ui.icon('search', 'size-4') }}</span>
                                <input type="search" id="menu-q" name="q" value="{{ app.request.query.get('q') }}" placeholder="Rechercher…" class="input has-icon">
                            </div>
                        </form>
                    </li>
                    {% for link in nav_links %}
                        {% set active = route in link.match %}
                        <li>
                            <a href="{{ path(link.route) }}" class="masthead-link{{ active ? ' is-active' : '' }}"{% if active %} aria-current="page"{% endif %}>
                                {{ link.label }}
                                {% if link.route == 'people_index' and unread_messages() %}
                                    <span class="badge badge-accent badge-count" title="Messages privés non lus">{{ unread_messages()|reduce((carry, n) => carry + n, 0) }}</span>
                                {% endif %}
                            </a>
                        </li>
                    {% endfor %}
                    <li>
                        <a href="{{ path('chat_index') }}" class="masthead-link{{ route == 'chat_index' ? ' is-active' : '' }}"{% if route == 'chat_index' %} aria-current="page"{% endif %}>
                            Chat
                            <span data-chat-badge data-count="{{ chat_unread_count() }}" class="badge badge-danger badge-count{{ chat_unread_count() > 0 ? '' : ' hidden' }}">{{ chat_unread_count() > 99 ? '99+' : chat_unread_count() }}</span>
                        </a>
                    </li>
                    <li class="masthead-menu-account">
                        <a href="{{ path('people_config', {username: app.user.username}) }}" class="masthead-link">Configuration</a>
                    </li>
                    <li class="masthead-menu-account">
                        <a href="{{ logout_path() }}" class="masthead-link">Déconnexion</a>
                    </li>
                </ul>
            </nav>
        {% endif %}
    </header>
    {% endblock %}

    <div class="page">
        {% for type, messages in app.flashes %}
            {% for message in messages %}
                {% set variant = type in ['error', 'danger'] ? 'danger' : (type == 'warning' ? 'warning' : (type == 'info' ? 'info' : 'ok')) %}
                <div class="alert alert-{{ variant }}" role="{{ variant == 'danger' ? 'alert' : 'status' }}">
                    <span class="alert-icon">{{ ui.icon(variant == 'ok' ? 'circle-check' : (variant == 'info' ? 'info' : 'circle-alert'), 'size-5') }}</span>
                    <div class="alert-body"><p>{{ message }}</p></div>
                    <button type="button" data-dismiss aria-label="Fermer">{{ ui.icon('x', 'size-4') }}</button>
                </div>
            {% endfor %}
        {% endfor %}

        {% block content_layout %}
            <div class="layout">
                <main id="main" class="layout-main" tabindex="-1">{% block body %}{% endblock %}</main>
                <aside class="layout-aside" aria-label="Raccourcis">
                    {% include '_layout/aside.html.twig' %}
                </aside>
            </div>
        {% endblock %}
    </div>

    {% block footer %}
    <footer class="colophon">
        <hr class="rule-double is-flush">
        <p class="colophon-text"><strong>ComTSo</strong> — forum privé <span aria-hidden="true">·</span> depuis 2004 <span aria-hidden="true">·</span> {{ 'now'|date('Y') }}</p>
    </footer>
    {% endblock %}

    {% block javascripts %}<script type="module" src="/assets/main.js"></script>{% endblock %}
</body>
</html>
