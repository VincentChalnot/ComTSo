{% import '_ui/icons.html.twig' as ui %}
{% set favorites = favorite_topics() %}
{% block aside_top %}{% endblock %}

<nav aria-label="Accès rapide">
    <ul class="menu">
        <li class="menu-title">{{ ui.icon('star', 'size-3.5', true) }} Accès rapide</li>
        {% for topic in favorites %}
            {% set isNew = app.user.previousLogin and topic.lastActivityAt > app.user.previousLogin %}
            <li>
                <a href="{{ path('topic_show', {forumId: topic.forum.id, id: topic.id}) }}" class="menu-item">
                    <span class="truncate">{{ topic.title }}</span>
                    {% if isNew %}<span class="badge badge-dot badge-accent" title="Nouveautés depuis votre dernière visite"><span class="sr-only">Nouveautés</span></span>{% endif %}
                </a>
            </li>
        {% else %}
            <li class="menu-note">Marquez un sujet avec l'étoile pour le retrouver ici.</li>
        {% endfor %}
    </ul>
</nav>

<nav aria-label="Forums">
    <ul class="menu">
        <li class="menu-title">Forums</li>
        {% for forum in nav_forums() %}
            <li><a href="{{ path('forum_show', {forumId: forum.id}) }}" class="menu-item">{{ forum.title }}</a></li>
        {% endfor %}
    </ul>
</nav>

{% set quote = random_quote() %}
{% if quote %}
    <figure class="aside-quote">
        <blockquote>{{ quote.content }}</blockquote>
        {% if quote.originalAuthor %}<figcaption>— {{ quote.originalAuthor }}</figcaption>{% endif %}
    </figure>
{% endif %}
