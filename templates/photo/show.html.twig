{% extends 'base.html.twig' %}
{% import '_ui/icons.html.twig' as ui %}

{% block title %}{{ photo.title ?: photo.originalFilename }} · ComTSo{% endblock %}

{% block body %}
{% set caption = photo.title ?: photo.originalFilename %}
<header class="page-header">
    <p class="kicker"><a href="{{ path('photo_index') }}">Photothèque</a></p>
    <h1 class="page-title">{{ caption }}</h1>
    <div class="page-actions">
        <a href="{{ photo_url(photo, 'download') }}" class="btn">{{ ui.icon('download', 'size-4') }} Télécharger ({{ (photo.fileSize / 1024)|round(1) }} Ko)</a>
        {% set canManage = app.user and (photo.author == app.user or is_granted('ROLE_ADMIN')) %}
        {% if canManage %}
            <a href="{{ path('photo_edit', {id: photo.id}) }}" class="btn btn-ghost">{{ ui.icon('pencil', 'size-4') }} Modifier</a>
            {% if photo.fileType != 'image/gif' %}
                {# A quarter turn re-encodes the stored picture: not offered for GIFs (animated ones cannot be turned). #}
                {% for direction, rotation in {left: {label: 'Pivoter à gauche', icon: 'rotate-ccw'}, right: {label: 'Pivoter à droite', icon: 'rotate-cw'}} %}
                    <form method="post" action="{{ path('photo_rotate', {id: photo.id}) }}" class="inline">
                        <input type="hidden" name="_token" value="{{ csrf_token('rotate-photo-' ~ photo.id) }}">
                        <input type="hidden" name="direction" value="{{ direction }}">
                        <button type="submit" class="btn btn-ghost">{{ ui.icon(rotation.icon, 'size-4') }} {{ rotation.label }}</button>
                    </form>
                {% endfor %}
            {% endif %}
            <form method="post" action="{{ path('photo_delete', {id: photo.id}) }}" class="inline"
                  data-confirm="{% if is_granted('ROLE_ADMIN') and (photo.topics|length or messageUsages) %}Supprimer définitivement cette photo ? Elle disparaîtra aussi des sujets et des messages où elle apparaît.{% else %}Supprimer définitivement cette photo ?{% endif %}">
                <input type="hidden" name="_token" value="{{ csrf_token('delete-photo-' ~ photo.id) }}">
                <button type="submit" class="btn btn-danger">{{ ui.icon('trash', 'size-4') }} Supprimer</button>
            </form>
        {% endif %}
    </div>
</header>

<figure class="photo-figure">
    <a href="{{ path('photo_show', {id: photo.id}) }}"
       data-lightbox="photo-{{ photo.id }}" data-photo-id="{{ photo.id }}" data-src="{{ photo_url(photo, 'medium') }}" data-full="{{ photo_url(photo, 'source') }}"
       data-download="{{ photo_url(photo, 'download') }}" data-caption="{{ caption }}">
        <img src="{{ photo_url(photo, 'medium') }}" alt="{{ caption }}">
    </a>
    <figcaption>
        <form method="post" action="{{ path('photo_like', {id: photo.id}) }}" class="like" id="likes">
            <input type="hidden" name="_token" value="{{ csrf_token('like-photo-' ~ photo.id) }}">
            <button type="submit" class="btn like-button{{ liked ? ' is-liked' : '' }}" aria-pressed="{{ liked ? 'true' : 'false' }}">
                {{ ui.icon('heart', 'size-4', liked) }}
                <span>{{ liked ? 'Je n\'aime plus' : 'J\'aime' }}</span>
                <span class="like-count" aria-label="{{ likeCount }} {{ likeCount > 1 ? 'mentions J\'aime' : 'mention J\'aime' }}">{{ likeCount }}</span>
            </button>
        </form>
        {% if likers %}
            <p class="like-likers">
                Aimé par
                {% for person in likers %}<a href="{{ path('people_show', {username: person.username}) }}">{{ person.username }}</a>{{ loop.last ? '' : ', ' }}{% endfor %}{% if likeCount > likers|length %} et {{ likeCount - likers|length }} autre{{ likeCount - likers|length > 1 ? 's' : '' }}{% endif %}
            </p>
        {% endif %}
        {% if photo.content %}<p>{{ photo.content|e|nl2br }}</p>{% endif %}
        <p class="byline">
            <span>{% if photo.author %}Ajoutée par <a href="{{ path('people_show', {username: photo.author.username}) }}">{{ photo.author.username }}</a> le {% else %}Ajoutée le {% endif %}<time datetime="{{ photo.createdAt|date('c') }}">{{ photo.createdAt|date('d/m/Y à H:i') }}</time></span>
            {% if photo.updatedAt and photo.updatedAt.timestamp - photo.createdAt.timestamp > 120 %}<span>modifiée le <time datetime="{{ photo.updatedAt|date('c') }}">{{ photo.updatedAt|date('d/m/Y à H:i') }}</time></span>{% endif %}
        </p>
    </figcaption>
</figure>

<div class="section grid gap-x-16 gap-y-12 md:grid-cols-2">
    <section aria-labelledby="photo-details">
        <h2 class="section-title" id="photo-details">Détails</h2>
        <dl class="dl">
            {% for row in photo_details(photo, canSeeGps) %}
                <dt>{{ row.label }}</dt><dd>{% if row.url is defined %}<a href="{{ row.url }}" rel="noopener noreferrer" target="_blank">{{ row.value }}</a>{% else %}{{ row.value }}{% endif %}</dd>
            {% endfor %}
        </dl>
    </section>

    {% if photo.topics|length or messageUsages %}
        <section aria-labelledby="photo-usages">
            <h2 class="section-title" id="photo-usages">Cette photo apparaît dans</h2>
            <ul class="photo-usages">
                {% for link in photo.topics %}
                    <li>
                        <p class="photo-usage-title"><a href="{{ path('topic_show', {forumId: link.topic.forum.id, id: link.topic.id}) }}">{{ link.topic.title }}</a></p>
                        <p class="photo-usage-meta">Sujet · {{ link.topic.forum.title }}</p>
                    </li>
                {% endfor %}
                {% for link in messageUsages %}
                    {% set comment = link.comment %}
                    <li>
                        <p class="photo-usage-title"><a href="{{ path('comment_show', {id: comment.id}) }}">Message de {{ comment.author ? comment.author.username : 'un ancien membre' }}</a></p>
                        <p class="photo-usage-meta">du {{ comment.createdAt|date('d/m/Y') }} · dans <a href="{{ path('topic_show', {forumId: comment.topic.forum.id, id: comment.topic.id}) }}">{{ comment.topic.title }}</a> · {{ comment.topic.forum.title }}</p>
                    </li>
                {% endfor %}
            </ul>
        </section>
    {% endif %}
</div>
{% endblock %}
