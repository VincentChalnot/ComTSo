{% extends 'base.html.twig' %}
{% import '_ui/photo.html.twig' as ph %}

{% block title %}Photos · ComTSo{% endblock %}

{% block body %}
<h1 class="mb-4 text-2xl font-bold tracking-tight">Photos</h1>
{% include '_layout/pagination.html.twig' with {pager: pager, route: 'photo_index', params: {}} %}
<div class="grid grid-cols-3 gap-2 sm:grid-cols-4 md:grid-cols-5">
    {% for photo in photos %}
        {{ ph.thumb(photo, 'all', 'aspect-square w-full') }}
    {% else %}
        <p class="col-span-full card p-6 text-center text-muted">Aucune photo.</p>
    {% endfor %}
</div>
{% include '_layout/pagination.html.twig' with {pager: pager, route: 'photo_index', params: {}} %}
{% endblock %}
