{# A topic as a card: title + favourite toggle, photos, then messages. Params: topic, comments, photos, created (bool), hidden (int) #}
{% import '_ui/icons.html.twig' as ui %}
{% import '_ui/photo.html.twig' as ph %}
{% set starred = app.user.starredTopics.contains(topic) %}
<section class="card overflow-hidden" aria-labelledby="topic-{{ topic.id }}">
    <header class="flex items-start gap-2 border-b border-line bg-surface-2 px-4 py-3">
        {% include 'topic/_star.html.twig' %}
        <div class="min-w-0 flex-1">
            <h3 id="topic-{{ topic.id }}" class="truncate text-lg font-semibold leading-snug">
                <a href="{{ path('topic_show', {forumId: topic.forum.id, id: topic.id}) }}" class="text-fg no-underline hover:underline">{{ topic.title }}</a>
            </h3>
            <p class="text-xs text-muted">
                <a href="{{ path('forum_show', {forumId: topic.forum.id}) }}" class="text-muted">{{ topic.forum.title }}</a>
                · {{ topic.commentCount }} message{{ topic.commentCount > 1 ? 's' : '' }}
                {% if created %}· <span class="font-medium text-accent-strong">nouveau sujet</span>{% endif %}
            </p>
        </div>
    </header>

    {% if created and topic.content %}
        <div class="border-b border-line px-4 py-3"><div class="post-body" data-collapsible>{{ topic.content|rich_text }}</div></div>
    {% endif %}

    {% if photos %}
        <div class="flex flex-wrap gap-2 border-b border-line px-4 py-3">
            {% for link in photos %}{{ ph.thumb(link.photo, 'digest-' ~ topic.id, 'size-24 sm:size-28') }}{% endfor %}
        </div>
    {% endif %}

    {% if hidden > 0 %}
        <p class="border-b border-line bg-surface-2 px-4 py-2 text-center text-xs text-muted">
            {{ hidden }} message{{ hidden > 1 ? 's' : '' }} plus ancien{{ hidden > 1 ? 's' : '' }} non affiché{{ hidden > 1 ? 's' : '' }} —
            <a href="{{ path('topic_show', {forumId: topic.forum.id, id: topic.id}) }}">voir le sujet</a>
        </p>
    {% endif %}

    {% for comment in comments %}
        {% include '_post/message.html.twig' %}
    {% endfor %}

    <footer class="border-t border-line bg-surface-2 px-4 py-3 text-center">
        <a href="{{ path('topic_show', {forumId: topic.forum.id, id: topic.id}) }}" class="btn btn-primary">Voir le sujet</a>
    </footer>
</section>
