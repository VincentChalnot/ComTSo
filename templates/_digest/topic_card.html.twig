{# A topic as a magazine entry: forum kicker, display title + favourite toggle, new description / photos, the new messages.
   Params: topic, comments, photos, created (bool), hidden (int), replyForm (FormView), order ('asc'|'desc': the reply sits where the next message will appear) #}
{% import '_ui/photo.html.twig' as ph %}
{% set starred = app.user.starredTopics.contains(topic) %}
{% set topicUrl = path('topic_show', {forumId: topic.forum.id, id: topic.id}) %}
<section class="digest" aria-labelledby="topic-{{ topic.id }}">
    <header class="digest-head">
        <p class="kicker">
            <span><a href="{{ path('forum_show', {forumId: topic.forum.id}) }}">{{ topic.forum.title }}</a>
            · {{ topic.commentCount }} message{{ topic.commentCount > 1 ? 's' : '' }}{% if created %} · nouveau sujet{% endif %}</span>
        </p>
        <div class="digest-title-row">
            <h3 id="topic-{{ topic.id }}" class="digest-title"><a href="{{ topicUrl }}">{{ topic.title }}</a></h3>
            {% include 'topic/_star.html.twig' %}
        </div>
    </header>

    {% if created and topic.content %}
        <div class="post-body is-lead" data-collapsible>{{ topic.content|rich_text }}</div>
    {% endif %}

    {% if photos %}
        <ul class="post-photos{{ photos|length > 6 ? ' is-wide' }}" aria-label="Photos du sujet">
            {% for link in photos %}<li class="post-photo">{{ ph.thumb(link.photo, 'digest-' ~ topic.id, 'size-24 sm:size-28') }}</li>{% endfor %}
        </ul>
    {% endif %}

    {% if hidden > 0 %}
        <p class="digest-note">
            {{ hidden }} message{{ hidden > 1 ? 's' : '' }} plus ancien{{ hidden > 1 ? 's' : '' }} non affiché{{ hidden > 1 ? 's' : '' }} —
            <a href="{{ topicUrl }}">voir le sujet</a>
        </p>
    {% endif %}

    {% if 'desc' == order %}
        {% include '_digest/_actions.html.twig' with {topic: topic, topicUrl: topicUrl, replyForm: replyForm} only %}
    {% endif %}

    {% if comments %}
        <div class="digest-posts">
            {% for comment in comments %}
                {% include '_post/message.html.twig' %}
            {% endfor %}
        </div>
    {% endif %}

    {% if 'asc' == order %}
        {% include '_digest/_actions.html.twig' with {topic: topic, topicUrl: topicUrl, replyForm: replyForm} only %}
    {% endif %}
</section>
