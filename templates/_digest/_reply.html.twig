{# Compact reply of a digest card (posts to topic_reply, comes back to the home page). Params: topic, replyForm (FormView) #}
{% import '_ui/icons.html.twig' as ui %}
{% import '_ui/avatar.html.twig' as av %}
{{ form_start(replyForm) }}
    <section class="reply is-compact" aria-labelledby="reply-{{ topic.id }}">
        <span class="reply-avatar">{{ av.avatar(app.user, 'sm') }}</span>
        <div class="reply-body">
            <h4 id="reply-{{ topic.id }}" class="sr-only">Répondre à « {{ topic.title }} »</h4>
            {{ form_errors(replyForm) }}
            {{ form_row(replyForm.content) }}
        </div>
        <div class="reply-actions">
            <button type="submit" class="btn btn-primary btn-sm">{{ ui.icon('send', 'size-3.5') }} Répondre</button>
        </div>
    </section>
{{ form_end(replyForm) }}
