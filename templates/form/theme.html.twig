{% use 'form_div_layout.html.twig' %}

{# Design-system form theme (components/_form.scss): every text-like widget is a `.input`, rows are `.field` (label, widget, help, errors),
   checkboxes and radios are `.check` boxes styled globally, buttons are `.btn`. #}
{% block form_row -%}
    <div class="field mb-5">
        {{- form_label(form) -}}
        {{- form_widget(form) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock form_row %}

{# A single checkbox / radio: the box and its label sit on one line. #}
{% block checkbox_row -%}
    {%- if label is empty and label is not same as(false) -%}{%- set label = name|humanize -%}{%- endif -%}
    <div class="field mb-5">
        <label class="check"{% if id %} for="{{ id }}"{% endif %}>
            {{- form_widget(form) -}}
            {%- if label is not same as(false) %}<span>{{ translation_domain is same as(false) ? label : label|trans(label_translation_parameters, translation_domain) }}</span>{% endif -%}
        </label>
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock checkbox_row %}

{% block radio_row -%}
    {{- block('checkbox_row') -}}
{%- endblock radio_row %}

{% block form_label -%}
    {%- if label is not same as(false) -%}
        {# the label of a checkbox / radio inside a `.check` is plain text #}
        {%- if 'checkbox' not in block_prefixes and 'radio' not in block_prefixes -%}
            {%- set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' label')|trim}) -%}
        {%- endif -%}
        {{- parent() -}}
    {%- endif -%}
{%- endblock form_label %}

{% block form_widget_simple -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' input')|trim}) -%}
    {{- parent() -}}
{%- endblock form_widget_simple %}

{% block textarea_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' input')|trim}) -%}
    {{- parent() -}}
{%- endblock textarea_widget %}

{% block choice_widget_collapsed -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' input')|trim}) -%}
    {{- parent() -}}
{%- endblock choice_widget_collapsed %}

{% block date_widget -%}
    {%- if widget == 'single_text' -%}
        {{- block('form_widget_simple') -}}
    {%- else -%}
        {{- parent() -}}
    {%- endif -%}
{%- endblock date_widget %}

{% block choice_widget_expanded -%}
    <div {{ block('widget_container_attributes') }} class="check-group">
        {%- for child in form %}
            <div class="check">
                {{- form_widget(child) -}}
                {{- form_label(child, null, {translation_domain: choice_translation_domain}) -}}
            </div>
        {% endfor -%}
    </div>
{%- endblock choice_widget_expanded %}

{% block form_help -%}
    {%- if help is not empty -%}
        <p id="{{ id }}_help" class="field-help">{{ translation_domain is same as(false) ? help : help|trans(help_translation_parameters|default({}), translation_domain) }}</p>
    {%- endif -%}
{%- endblock form_help %}

{% block form_errors -%}
    {%- if errors|length > 0 -%}
        <ul class="grid gap-1">
            {%- for error in errors -%}
                <li class="field-error">{{ error.message }}</li>
            {%- endfor -%}
        </ul>
    {%- endif -%}
{%- endblock form_errors %}

{% block button_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('btn btn-primary'))|trim}) -%}
    {{- parent() -}}
{%- endblock button_widget %}
