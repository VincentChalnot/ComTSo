{% use 'form_div_layout.html.twig' %}

{# Tailwind form theme: every widget gets the shared `.input` look, rows get a label/help/error layout. #}
{% block form_row -%}
    <div class="mb-4">
        {{- form_label(form) -}}
        {{- form_widget(form) -}}
        {{- form_help(form) -}}
        {{- form_errors(form) -}}
    </div>
{%- endblock form_row %}

{% block form_label -%}
    {%- if label is not same as(false) -%}
        {%- set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' label')|trim}) -%}
        {{- parent() -}}
    {%- endif -%}
{%- endblock form_label %}

{% block form_widget_simple -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' input')|trim}) -%}
    {{- parent() -}}
{%- endblock form_widget_simple %}

{% block textarea_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' input')|trim}) -%}
    {{- parent() -}}
{%- endblock textarea_widget %}

{% block choice_widget_collapsed -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' input')|trim}) -%}
    {{- parent() -}}
{%- endblock choice_widget_collapsed %}

{% block date_widget -%}
    {%- if widget == 'single_text' -%}
        {{- block('form_widget_simple') -}}
    {%- else -%}
        {{- parent() -}}
    {%- endif -%}
{%- endblock date_widget %}

{% block choice_widget_expanded -%}
    <div {{ block('widget_container_attributes') }} class="space-y-2">
        {%- for child in form %}
            <div class="flex items-center gap-2">
                {{- form_widget(child, {attr: {class: 'size-4 accent-[var(--c-accent)]'}}) -}}
                {{- form_label(child, null, {label_attr: {class: '!mb-0 !font-normal'}}) -}}
            </div>
        {% endfor -%}
    </div>
{%- endblock choice_widget_expanded %}

{% block checkbox_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('') ~ ' size-4')|trim}) -%}
    <input type="checkbox" {{ block('widget_attributes') }}{% if value is defined %} value="{{ value }}"{% endif %}{% if checked %} checked="checked"{% endif %} />
{%- endblock checkbox_widget %}

{% block radio_widget -%}
    <input type="radio" {{ block('widget_attributes') }}{% if value is defined %} value="{{ value }}"{% endif %}{% if checked %} checked="checked"{% endif %} />
{%- endblock radio_widget %}

{% block form_help -%}
    {%- if help is not empty -%}
        <p id="{{ id }}_help" class="mt-1 text-xs text-muted">{{ help }}</p>
    {%- endif -%}
{%- endblock form_help %}

{% block form_errors -%}
    {%- if errors|length > 0 -%}
        <ul class="mt-1 space-y-0.5">
            {%- for error in errors -%}
                <li class="field-error">{{ error.message }}</li>
            {%- endfor -%}
        </ul>
    {%- endif -%}
{%- endblock form_errors %}

{% block button_widget -%}
    {%- set attr = attr|merge({class: (attr.class|default('btn btn-primary'))|trim}) -%}
    {{- parent() -}}
{%- endblock button_widget %}
