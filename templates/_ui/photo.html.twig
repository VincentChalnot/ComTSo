{# Thumbnail that opens in the lightbox (falls back to the photo page without JavaScript). Styled by `.photo-thumb` (components/_photo.scss).
   `size` = layout utilities that give the tile its box: 'size-28' (default), 'size-24 sm:size-32', 'aspect-square w-full'…
   {% import '_ui/photo.html.twig' as ph %}{{ ph.thumb(photo, 'topic-12', 'size-28') }} #}
{% macro thumb(photo, group, size = 'size-28') %}
<a href="{{ path('photo_show', {id: photo.id}) }}"
   class="photo-thumb shrink-0 {{ size }}"
   data-lightbox="{{ group }}"
   data-photo-id="{{ photo.id }}"
   data-src="{{ path('photo_variant', {id: photo.id, variant: 'medium'}) }}"
   data-full="{{ path('photo_source', {id: photo.id}) }}"
   data-download="{{ path('photo_source', {id: photo.id, download: 1}) }}"
   data-page="{{ path('photo_show', {id: photo.id}) }}"
   data-caption="{{ photo.title ?: photo.originalFilename }}">
    <img src="{{ path('photo_variant', {id: photo.id, variant: 'thumb'}) }}" alt="{{ photo.title ?: photo.originalFilename }}" loading="lazy">
</a>
{% endmacro %}
