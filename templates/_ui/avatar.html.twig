{# {% import '_ui/avatar.html.twig' as av %}{{ av.avatar(user, 'size-10') }} #}
{% macro avatar(user, size = 'size-10') %}
{%- if user is null -%}
    <span class="{{ size }} inline-flex shrink-0 items-center justify-center rounded-full bg-surface-2 text-xs font-semibold text-muted">?</span>
{%- elseif user.avatar -%}
    <img src="{{ path('photo_variant', {id: user.avatar.id, variant: 'avatar'}) }}" alt="{{ user.username }}" title="{{ user.username }}" width="96" height="96" loading="lazy" class="{{ size }} shrink-0 rounded-full bg-surface-2 object-cover">
{%- else -%}
    <span title="{{ user.username }}" class="{{ size }} inline-flex shrink-0 items-center justify-center rounded-full text-sm font-semibold text-white" style="background-color: hsl({{ user_hue(user) }} 42% 42%)">{{ user.username|slice(0, 1)|upper }}</span>
{%- endif -%}
{% endmacro %}
