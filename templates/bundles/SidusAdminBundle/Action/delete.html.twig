{# @var action \Sidus\AdminBundle\Model\Action #}
{# Confirmation page of a removal (GET changes nothing): the empty form carries the CSRF token, the POST removes. `details` lists what goes along. #}
{% extends action.baseTemplate %}

{% block title %}{{ ('admin.' ~ admin.code ~ '.delete')|trans }} · Administration · ComTSo{% endblock %}

{% block container %}
    <header class="page-header">
        <p class="kicker"><a href="{{ listPath }}">{{ ('admin.' ~ admin.code ~ '.title')|trans }}</a></p>
        <h1 class="page-title">{{ ('admin.' ~ admin.code ~ '.delete')|trans }}</h1>
    </header>

    <div class="admin-form">
        <div class="alert alert-danger" role="alert">
            <div class="alert-body">
                <p class="alert-title">{{ ('admin.' ~ admin.code ~ '.delete_confirm')|trans({'%entity%': data|tostring}) }}</p>
                {% if details|default([]) is not empty %}
                    <ul class="admin-details">
                        {% for detail in details %}<li>{{ detail }}</li>{% endfor %}
                    </ul>
                {% endif %}
                <p>{{ 'admin.delete.irreversible'|trans }}</p>
            </div>
        </div>

        {{ form_start(form) }}
            {{ form_widget(form) }}
            <div class="form-actions">
                <a href="{{ listPath }}" class="btn btn-ghost">{{ 'admin.button.cancel'|trans }}</a>
                <button type="submit" class="btn btn-danger">{{ 'admin.button.delete'|trans }}</button>
            </div>
        {{ form_end(form) }}
    </div>
{% endblock %}
