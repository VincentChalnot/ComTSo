{% extends 'base.html.twig' %}

{% block title %}Erreur {{ status_code }} · ComTSo{% endblock %}

{% block content_layout %}
<main class="mx-auto mt-16 max-w-md text-center">
    <p class="text-6xl font-bold text-accent">{{ status_code }}</p>
    <h1 class="mt-3 text-xl font-semibold">
        {% if status_code == 404 %}Cette page n'existe pas.{% elseif status_code == 403 %}Vous n'avez pas accès à cette page.{% else %}Une erreur est survenue.{% endif %}
    </h1>
    <p class="mt-6"><a href="{{ path('app_home') }}" class="btn btn-primary">Retour à l'accueil</a></p>
</main>
{% endblock %}
