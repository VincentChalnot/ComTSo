{% extends 'base.html.twig' %}

{% block title %}Erreur {{ status_code }} · ComTSo{% endblock %}

{% block content_layout %}
<main id="main" class="error-page" tabindex="-1">
    <p class="error-code" aria-hidden="true">{{ status_code }}</p>
    <p class="kicker">Erreur {{ status_code }}</p>
    <h1 class="error-title">
        {% if status_code == 404 %}Cette page n'existe pas.{% elseif status_code == 403 %}Vous n'avez pas accès à cette page.{% else %}Une erreur est survenue.{% endif %}
    </h1>
    <p class="error-text">
        {% if status_code == 404 %}Le lien est peut-être ancien, ou le sujet a été déplacé. Vous retrouverez votre chemin depuis l'accueil.
        {% elseif status_code == 403 %}Ce forum est réservé aux membres du cercle. Si vous pensez qu'il s'agit d'une erreur, écrivez à l'administrateur.
        {% else %}Ce n'est pas de votre faute. Réessayez dans un instant ; si le problème persiste, prévenez l'administrateur.{% endif %}
    </p>
    <hr class="rule-double">
    <p class="error-actions"><a href="{{ path('app_home') }}" class="btn btn-primary">Retour à l'accueil</a></p>
</main>
{% endblock %}
