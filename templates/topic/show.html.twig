{% extends 'base.html.twig' %}
{% import '_ui/icons.html.twig' as ui %}
{% import '_ui/photo.html.twig' as ph %}
{% import '_ui/avatar.html.twig' as av %}

{% block title %}{{ topic.title }} · ComTSo{% endblock %}

{% block body %}
{% set canManage = topic.author == app.user or is_granted('ROLE_ADMIN') %}
{% include 'forum/_tabs.html.twig' with {current: topic.forum.id} %}

<header class="page-header">
    <p class="kicker"><a href="{{ path('forum_show', {forumId: topic.forum.id}) }}" class="text-inherit no-underline hover:underline">{{ topic.forum.title }}</a></p>
    <h1 class="page-title">{{ topic.title }}</h1>
    <p class="byline">
        {% if topic.author %}<span>Par <a href="{{ path('people_show', {username: topic.author.username}) }}">{{ topic.author.username }}</a></span>{% endif %}
        <time datetime="{{ topic.createdAt|date('c') }}">{{ topic.createdAt|date('d/m/Y à H:i') }}</time>
        <span>{{ topic.commentCount }} message{{ topic.commentCount > 1 ? 's' : '' }}</span>
        <span>{{ topic.views }} vue{{ topic.views > 1 ? 's' : '' }}</span>
    </p>
    <div class="page-actions">
        {% include 'topic/_star.html.twig' %}
        {% if canManage %}
            <a href="{{ path('topic_edit', {forumId: topic.forum.id, id: topic.id}) }}" class="btn btn-sm">{{ ui.icon('pencil', 'size-3.5') }} Modifier</a>
            <a href="{{ path('topic_photos', {forumId: topic.forum.id, id: topic.id}) }}" class="btn btn-sm">{{ ui.icon('image', 'size-3.5') }} Photos</a>
        {% endif %}
    </div>
</header>

{% if topic.content or photos %}
    <section class="stack mb-12" aria-label="Présentation du sujet">
        {% if topic.content %}
            <div class="post-body is-lead" data-collapsible>{{ topic.content|rich_text }}</div>
        {% endif %}
        {% if photos %}
            <ul class="post-photos{{ photos|length > 6 ? ' is-wide' }}" aria-label="Photos du sujet">
                {% for link in photos %}<li class="post-photo">{{ ph.thumb(link.photo, 'topic-' ~ topic.id, 'size-24 sm:size-32') }}</li>{% endfor %}
            </ul>
        {% endif %}
    </section>
{% endif %}

{% include '_layout/pagination.html.twig' with {pager: pager, route: 'topic_show', params: {forumId: topic.forum.id, id: topic.id}} %}

<section aria-label="Messages" class="my-6 border-b border-line">
    {% for comment in comments %}
        {% include '_post/message.html.twig' %}
    {% else %}
        <p class="empty is-plain">Aucun message pour le moment.</p>
    {% endfor %}
</section>

{% include '_layout/pagination.html.twig' with {pager: pager, route: 'topic_show', params: {forumId: topic.forum.id, id: topic.id}} %}

{{ form_start(commentForm) }}
    <section class="reply mt-8" aria-labelledby="reply">
        <span class="reply-avatar">{{ av.avatar(app.user, 'md') }}</span>
        <div class="reply-body">
            <h2 id="reply" class="card-title mb-2">Répondre</h2>
            {{ form_row(commentForm.content) }}
            {{ form_row(commentForm.photos) }}
        </div>
        <div class="reply-actions">
            <button type="submit" class="btn btn-primary">{{ ui.icon('send', 'size-4') }} Envoyer</button>
        </div>
    </section>
{{ form_end(commentForm) }}
{% endblock %}
