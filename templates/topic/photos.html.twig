{% extends 'base.html.twig' %}

{% block title %}Photos de « {{ topic.title }} » · ComTSo{% endblock %}

{% block body %}
<header class="page-header">
    <p class="kicker"><a href="{{ path('forum_show', {forumId: topic.forum.id}) }}" class="text-inherit no-underline hover:underline">{{ topic.forum.title }}</a></p>
    <h1 class="page-title">Gestion des photos</h1>
    <p class="standfirst">Sujet : <a href="{{ path('topic_show', {forumId: topic.forum.id, id: topic.id}) }}">{{ topic.title }}</a></p>
</header>

<div data-vue-component="PhotoManager" data-props="{{ {
    uploadUrl: path('topic_photos_upload', {forumId: topic.forum.id, id: topic.id}),
    orderUrl: path('topic_photos_order', {forumId: topic.forum.id, id: topic.id}),
    removeUrl: path('topic_photo_remove', {forumId: topic.forum.id, id: topic.id, linkId: 0}),
    token: csrf_token('photos-' ~ topic.id),
    photos: photos|map(link => {link: link.id, id: link.photo.id, title: link.photo.title ?: link.photo.originalFilename, thumb: photo_url(link.photo, 'thumb'), page: path('photo_show', {id: link.photo.id})}),
    backUrl: path('topic_show', {forumId: topic.forum.id, id: topic.id}),
}|json_encode|e('html_attr') }}"></div>
{% endblock %}
