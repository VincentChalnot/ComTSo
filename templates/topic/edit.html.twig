{% extends 'base.html.twig' %}

{% block title %}Modifier « {{ topic.title }} »{% endblock %}

{% block body %}
<h1 class="mb-4 text-2xl font-bold tracking-tight">Modifier le sujet</h1>
<div class="card p-5">
    {{ form_start(form) }}
        {{ form_widget(form) }}
        <div class="flex gap-2">
            <button type="submit" class="btn btn-primary">Enregistrer</button>
            <a href="{{ path('topic_show', {forumId: topic.forum.id, id: topic.id}) }}" class="btn">Annuler</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
