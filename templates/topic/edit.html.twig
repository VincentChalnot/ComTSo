{% extends 'base.html.twig' %}

{% block title %}Modifier « {{ topic.title }} »{% endblock %}

{% block body %}
<header class="page-header">
    <p class="kicker"><a href="{{ path('topic_show', {forumId: topic.forum.id, id: topic.id}) }}" class="text-inherit no-underline hover:underline">{{ topic.title }}</a></p>
    <h1 class="page-title">Modifier le sujet</h1>
</header>

<div class="card p-5 sm:p-8">
    {{ form_start(form) }}
        {{ form_widget(form) }}
        <div class="form-actions">
            <a href="{{ path('topic_show', {forumId: topic.forum.id, id: topic.id}) }}" class="btn btn-ghost">Annuler</a>
            <button type="submit" class="btn btn-primary">Enregistrer</button>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
