{# One message: avatar on the left, author + body (long ones are collapsed by ui.js), details and actions on hover / tap.
   Params: comment, hide_actions (optional). Attached photos open in a lightbox group per message. #}
{% import '_ui/icons.html.twig' as ui %}
{% import '_ui/avatar.html.twig' as av %}
{% import '_ui/photo.html.twig' as ph %}
{% set author = comment.author %}
{% set canManage = not hide_actions|default(false) and app.user and (author == app.user or is_granted('ROLE_ADMIN')) %}
<article class="post" id="post-{{ comment.id }}" data-post>
    {% if author %}
        <a href="{{ path('people_show', {username: author.username}) }}" class="shrink-0 self-start" title="{{ author.username }}">{{ av.avatar(author, 'md') }}</a>
    {% else %}
        <span class="shrink-0 self-start">{{ av.avatar(null, 'md') }}</span>
    {% endif %}
    <div class="min-w-0 flex-1">
        <p class="post-author">{{ author ? author.username : 'Ancien membre' }}</p>
        {% if comment.content %}<div class="post-body" data-collapsible>{{ comment.content|rich_text }}</div>{% endif %}
        {% if comment.photos|length %}
            <ul class="post-photos" aria-label="Photos du message">
                {% for link in comment.photos %}
                    <li class="post-photo">{{ ph.thumb(link.photo, 'post-' ~ comment.id, 'size-24 sm:size-32') }}</li>
                {% endfor %}
            </ul>
        {% endif %}
        <div class="post-meta">
            <time datetime="{{ comment.createdAt|date('c') }}">Posté le {{ comment.createdAt|date('d/m/Y à H:i') }}</time>
            {% if comment.updatedAt and comment.updatedAt.timestamp - comment.createdAt.timestamp > 120 %}
                <span>· modifié le {{ comment.updatedAt|date('d/m/Y à H:i') }}</span>
            {% endif %}
            <a href="{{ path('comment_show', {id: comment.id}) }}" title="Lien vers ce message">{{ ui.icon('link', 'size-3.5') }} Lien</a>
            {% if canManage %}
                <a href="{{ path('comment_edit', {id: comment.id}) }}">{{ ui.icon('pencil', 'size-3.5') }} Modifier</a>
                <form method="post" action="{{ path('comment_delete', {id: comment.id}) }}" data-confirm="Supprimer définitivement ce message ?">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete-comment-' ~ comment.id) }}">
                    <button type="submit" class="is-danger">{{ ui.icon('trash', 'size-3.5') }} Supprimer</button>
                </form>
            {% endif %}
        </div>
    </div>
</article>
