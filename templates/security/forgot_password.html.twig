{% extends 'security/_card.html.twig' %}

{% block title %}Mot de passe oublié · ComTSo{% endblock %}
{% block heading %}Mot de passe oublié{% endblock %}

{% block card %}
    <p class="auth-lead">Indiquez votre pseudo ou votre adresse e-mail : si un compte correspond, un lien pour choisir un nouveau mot de passe lui sera envoyé.</p>
    {{ form_start(form, {attr: {class: 'auth-form'}}) }}
        {{ form_widget(form) }}
        <button type="submit" class="btn btn-primary btn-lg btn-block">Envoyer le lien</button>
    {{ form_end(form) }}
    <p class="auth-footer"><a href="{{ path('app_login') }}">Retour à la connexion</a></p>
{% endblock %}
