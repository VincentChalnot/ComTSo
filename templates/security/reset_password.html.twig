{% extends 'security/_card.html.twig' %}

{% block title %}Nouveau mot de passe · ComTSo{% endblock %}
{% block heading %}Nouveau mot de passe{% endblock %}

{% block card %}
    <p class="auth-lead">{{ username }}, choisissez votre nouveau mot de passe.</p>
    {{ form_start(form, {attr: {class: 'auth-form'}}) }}
        {{ form_widget(form) }}
        <button type="submit" class="btn btn-primary btn-lg btn-block">Enregistrer le mot de passe</button>
    {{ form_end(form) }}
{% endblock %}
