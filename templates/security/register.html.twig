{% extends 'base.html.twig' %}

{% block title %}Inscription · ComTSo{% endblock %}

{% block content_layout %}
<main class="mx-auto mt-10 max-w-sm">
    <div class="card p-6">
        <h1 class="mb-5 text-2xl font-bold tracking-tight">Inscription</h1>
        {{ form_start(registrationForm) }}
            {{ form_widget(registrationForm) }}
            <button type="submit" class="btn btn-primary w-full">Créer mon compte</button>
        {{ form_end(registrationForm) }}
        <p class="mt-4 text-center text-sm text-muted">Déjà inscrit ? <a href="{{ path('app_login') }}">Se connecter</a></p>
    </div>
</main>
{% endblock %}
