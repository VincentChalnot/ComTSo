{% extends 'base.html.twig' %}

{% block title %}Connexion · ComTSo{% endblock %}

{% block content_layout %}
<main class="mx-auto mt-10 max-w-sm">
    <div class="card p-6">
        <h1 class="mb-1 text-2xl font-bold tracking-tight">Connexion</h1>
        <p class="mb-5 text-sm text-muted">Ce forum est privé : identifiez-vous pour continuer.</p>

        {% if error %}
            <div class="mb-4 rounded-lg border border-danger/40 bg-danger/10 px-3 py-2 text-sm text-danger" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
        {% endif %}

        <form method="post">
            <div class="mb-4">
                <label for="username" class="label">Pseudo</label>
                <input type="text" id="username" name="_username" value="{{ last_username }}" class="input" required autofocus autocomplete="username">
            </div>
            <div class="mb-4">
                <label for="password" class="label">Mot de passe</label>
                <input type="password" id="password" name="_password" class="input" required autocomplete="current-password">
            </div>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
            <button type="submit" class="btn btn-primary w-full">Se connecter</button>
        </form>

        {% if registration_enabled %}
            <p class="mt-4 text-center text-sm text-muted">Pas encore de compte ? <a href="{{ path('app_register') }}">S'inscrire</a></p>
        {% endif %}
    </div>
</main>
{% endblock %}
