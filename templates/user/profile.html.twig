{% extends 'base.html.twig' %}

{% block title %}{{ user.username }}'s Profile{% endblock %}

{% block body %}
<div class="level">
    <div class="level-left">
        <div class="level-item">
            <h1 class="title">{{ user.username }}</h1>
        </div>
    </div>
    <div class="level-right">
        <div class="level-item">
            {% if app.user == user %}
                <a href="{{ path('user_profile_edit', {'username': user.username}) }}" class="button">Edit Profile</a>
            {% endif %}
        </div>
    </div>
</div>

<div class="box">
    <div class="content">
        {% if user.name or user.surname %}
            <p><strong>Name:</strong> {{ user.name }} {{ user.surname }}</p>
        {% endif %}
        
        {% if user.email and app.user == user %}
            <p><strong>Email:</strong> {{ user.email }}</p>
        {% endif %}
        
        {% if user.birthday %}
            <p><strong>Birthday:</strong> {{ user.birthday|date('Y-m-d') }}</p>
        {% endif %}
        
        {% if user.website %}
            <p><strong>Website:</strong> <a href="{{ user.website }}" target="_blank">{{ user.website }}</a></p>
        {% endif %}
        
        {% if user.activities %}
            <p><strong>Activities:</strong> {{ user.activities|nl2br }}</p>
        {% endif %}
        
        {% if user.signature %}
            <p><strong>Signature:</strong> {{ user.signature|nl2br }}</p>
        {% endif %}
        
        <p><strong>Member since:</strong> {{ user.registeredAt|date('Y-m-d') }}</p>
    </div>
</div>
{% endblock %}
