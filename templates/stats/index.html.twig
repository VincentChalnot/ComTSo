{% extends 'base.html.twig' %}

{% block title %}Statistiques · ComTSo{% endblock %}

{% block body %}
{% set total = report.totals.comments + report.totals.chat %}
<header class="page-header">
    <p class="kicker">Statistiques</p>
    <h1 class="page-title">Qui écrit, et quand</h1>
    {% if total == 0 %}
        <p class="standfirst">Aucun message pour l’instant.</p>
    {% else %}
        <p class="standfirst">
            {{ report.totals.comments|number_format(0, ',', ' ') }} messages sur le forum et {{ report.totals.chat|number_format(0, ',', ' ') }} dans le chat, de {{ report.years|first }} à {{ report.years|last }}.
        </p>
    {% endif %}
</header>

{% if total > 0 %}
    {% set yearChart = {
        title: 'Messages par année',
        labels: report.yearTotals|map(y => y.year ~ ''),
        series: [
            {name: 'Forum', values: report.yearTotals|map(y => y.comments)},
            {name: 'Chat', values: report.yearTotals|map(y => y.chat)},
        ],
    } %}
    {% set memberChart = {
        title: 'Messages par membre',
        horizontal: true,
        labels: report.members|map(m => m.username ?? 'Anciens membres'),
        series: [
            {name: 'Forum', values: report.members|map(m => m.commentTotal)},
            {name: 'Chat', values: report.members|map(m => m.chatTotal)},
        ],
    } %}

    <section class="section" aria-labelledby="stats-years">
        <h2 class="section-title" id="stats-years">Par année</h2>
        <div data-vue-component="StatsChart" data-props="{{ yearChart|json_encode|e('html_attr') }}">
            <p class="settings-hint">Le graphique demande JavaScript ; le tableau ci-dessous donne les mêmes chiffres.</p>
        </div>
    </section>

    <section class="section" aria-labelledby="stats-members">
        <h2 class="section-title" id="stats-members">Par membre</h2>
        <div data-vue-component="StatsChart" data-props="{{ memberChart|json_encode|e('html_attr') }}">
            <p class="settings-hint">Le graphique demande JavaScript ; le tableau ci-dessous donne les mêmes chiffres.</p>
        </div>
    </section>

    <section class="section" aria-labelledby="stats-table">
        <h2 class="section-title" id="stats-table">Détail : messages du forum par membre et par année</h2>
        <div class="table-responsive">
            <table class="table table-striped table-sm tabular" data-stats-table>
                <caption class="sr-only">Nombre de messages du forum par membre et par année, avec les totaux et le nombre de messages du chat</caption>
                <thead>
                    <tr>
                        <th scope="col">Membre</th>
                        {% for year in report.years %}<th scope="col">{{ year }}</th>{% endfor %}
                        <th scope="col">Total</th>
                        <th scope="col">Chat</th>
                    </tr>
                </thead>
                <tbody>
                    {% for member in report.members %}
                        <tr>
                            <th scope="row">
                                {% if member.username is null %}Anciens membres
                                {% elseif member.enabled %}<a href="{{ path('people_show', {username: member.username}) }}">{{ member.username }}</a>
                                {% else %}{{ member.username }}{% endif %}
                            </th>
                            {% for year in report.years %}<td>{{ member.comments[year] is defined ? member.comments[year]|number_format(0, ',', ' ') : '' }}</td>{% endfor %}
                            <td>{{ member.commentTotal|number_format(0, ',', ' ') }}</td>
                            <td>{{ member.chatTotal|number_format(0, ',', ' ') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr>
                        <th scope="row">Total</th>
                        {% for year in report.yearTotals %}<td>{{ year.comments|number_format(0, ',', ' ') }}</td>{% endfor %}
                        <td>{{ report.totals.comments|number_format(0, ',', ' ') }}</td>
                        <td>{{ report.totals.chat|number_format(0, ',', ' ') }}</td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </section>
{% endif %}
{% endblock %}
