{% extends 'base.html.twig' %}

{% block title %}Messages{% endblock %}

{% block body %}
<div class="level">
    <div class="level-left">
        <div class="level-item">
            <h1 class="title">Messages</h1>
        </div>
    </div>
    <div class="level-right">
        <div class="level-item">
            <a href="{{ path('message_compose') }}" class="button is-primary">Compose Message</a>
        </div>
    </div>
</div>

<div class="tabs">
    <ul>
        <li class="is-active"><a>Received</a></li>
        <li><a>Sent</a></li>
    </ul>
</div>

<h2 class="subtitle">Received Messages</h2>
{% for message in received_messages %}
    <div class="box">
        <p class="title is-6">
            <a href="{{ path('message_show', {'id': message.id}) }}">
                From: {{ message.author.username }}
            </a>
            {% if message.state == null %}
                <span class="tag is-info">New</span>
            {% endif %}
        </p>
        <p class="is-size-7">{{ message.createdAt|date('Y-m-d H:i') }}</p>
    </div>
{% else %}
    <p>No messages received.</p>
{% endfor %}

<h2 class="subtitle mt-5">Sent Messages</h2>
{% for message in sent_messages %}
    <div class="box">
        <p class="title is-6">
            <a href="{{ path('message_show', {'id': message.id}) }}">
                To: {{ message.recipient.username }}
            </a>
        </p>
        <p class="is-size-7">{{ message.createdAt|date('Y-m-d H:i') }}</p>
    </div>
{% else %}
    <p>No messages sent.</p>
{% endfor %}
{% endblock %}
