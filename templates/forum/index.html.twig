{% extends 'base.html.twig' %}

{% block title %}Les forums · ComTSo{% endblock %}

{% block body %}
<header class="page-header">
    <p class="kicker">Forums</p>
    <h1 class="page-title">Les forums</h1>
    <p class="standfirst">Choisissez une rubrique : chaque forum rassemble ses sujets, leurs photos et les dernières discussions du cercle.</p>
</header>

<ol class="toc">
    {% for forum in nav_forums() %}
        <li class="toc-entry">
            <span class="toc-index" aria-hidden="true">{{ '%02d'|format(loop.index) }}</span>
            <div class="toc-body">
                <h2 class="toc-title"><a href="{{ path('forum_show', {forumId: forum.id}) }}">{{ forum.title }}</a></h2>
                {% if forum.content %}<div class="toc-desc">{{ forum.content|rich_text }}</div>{% endif %}
            </div>
            <p class="toc-meta">
                <span><strong>{{ stats[forum.id] }}</strong> sujet{{ stats[forum.id] > 1 ? 's' : '' }}</span>
                <span>dernière modification le {{ forum.updatedAt|date('d/m/Y') }}</span>
            </p>
        </li>
    {% endfor %}
</ol>
{% endblock %}
