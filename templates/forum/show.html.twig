{% extends 'base.html.twig' %}
{% import '_ui/icons.html.twig' as ui %}

{% block title %}{{ forum.title }} · ComTSo{% endblock %}

{% block body %}
{% include 'forum/_tabs.html.twig' with {current: forum.id} %}

<header class="page-header">
    <p class="kicker"><a href="{{ path('forum_index') }}" class="text-inherit no-underline hover:underline">Forums</a></p>
    <h1 class="page-title">{{ forum.title }}</h1>
    {% if forum.content %}<div class="standfirst">{{ forum.content|rich_text }}</div>{% endif %}
    <div class="page-actions">
        <a href="{{ path('forum_new_topic', {forumId: forum.id}) }}" class="btn btn-primary">{{ ui.icon('plus', 'size-4') }} Nouveau sujet</a>
    </div>
</header>

{% include '_layout/pagination.html.twig' with {pager: pager, route: 'forum_show', params: {forumId: forum.id}} %}

<div class="thread-preview-list my-8">
    {% for preview in previews %}
        {% include 'forum/_thread_preview.html.twig' %}
    {% else %}
        <p class="empty">
            <span class="empty-title">Aucun sujet dans ce forum pour le moment.</span>
            <span class="empty-text">Lancez la discussion avec un premier sujet.</span>
        </p>
    {% endfor %}
</div>

{% include '_layout/pagination.html.twig' with {pager: pager, route: 'forum_show', params: {forumId: forum.id}} %}
{% endblock %}
