{% extends 'base.html.twig' %}

{% block title %}{{ forum.title }}{% endblock %}

{% block body %}
<div class="level">
    <div class="level-left">
        <div class="level-item">
            <h1 class="title">{{ forum.title }}</h1>
        </div>
    </div>
    <div class="level-right">
        <div class="level-item">
            {% if app.user %}
                <a href="{{ path('forum_new_topic', {'id': forum.id}) }}" class="button is-primary">
                    New Topic
                </a>
            {% endif %}
        </div>
    </div>
</div>

{% if forum.content %}
    <div class="content">
        <p>{{ forum.content }}</p>
    </div>
{% endif %}

<hr>

{% if topics is empty %}
    <p>No topics in this forum yet.</p>
{% else %}
    {% for topic in topics %}
        <div class="box">
            <div class="media">
                <div class="media-content">
                    <p class="title is-5">
                        <a href="{{ path('topic_show', {'forumId': forum.id, 'id': topic.id}) }}">
                            {{ topic.title }}
                        </a>
                    </p>
                    <p class="subtitle is-7">
                        by {{ topic.author.username }}
                        • {{ topic.views }} views
                        • {{ topic.commentCount }} comments
                        • {{ topic.createdAt|date('Y-m-d H:i') }}
                    </p>
                </div>
            </div>
        </div>
    {% endfor %}
{% endif %}
{% endblock %}
