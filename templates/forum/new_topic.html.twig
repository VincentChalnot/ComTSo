{% extends 'base.html.twig' %}

{% block title %}Nouveau sujet · {{ forum.title }}{% endblock %}

{% block body %}
{% include 'forum/_tabs.html.twig' with {current: forum.id} %}
<h1 class="mb-4 text-2xl font-bold tracking-tight">Nouveau sujet dans « {{ forum.title }} »</h1>

<div class="card p-5">
    {{ form_start(form) }}
        {{ form_row(form.title) }}
        {{ form_row(form.content) }}
        <div class="flex gap-2">
            <button type="submit" class="btn btn-primary">Créer le sujet</button>
            <a href="{{ path('forum_show', {forumId: forum.id}) }}" class="btn">Annuler</a>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
