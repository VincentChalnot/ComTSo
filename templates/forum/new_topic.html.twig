{% extends 'base.html.twig' %}

{% block title %}Nouveau sujet · {{ forum.title }}{% endblock %}

{% block body %}
{% include 'forum/_tabs.html.twig' with {current: forum.id} %}

<header class="page-header">
    <p class="kicker"><a href="{{ path('forum_show', {forumId: forum.id}) }}" class="text-inherit no-underline hover:underline">{{ forum.title }}</a></p>
    <h1 class="page-title">Nouveau sujet</h1>
    <p class="standfirst">Donnez un titre, présentez le sujet et joignez vos photos si vous le souhaitez.</p>
</header>

<div class="card p-5 sm:p-8">
    {{ form_start(form) }}
        {{ form_row(form.title) }}
        {{ form_row(form.content) }}
        {{ form_row(form.photos) }}
        <div class="form-actions">
            <a href="{{ path('forum_show', {forumId: forum.id}) }}" class="btn btn-ghost">Annuler</a>
            <button type="submit" class="btn btn-primary">Créer le sujet</button>
        </div>
    {{ form_end(form) }}
</div>
{% endblock %}
