{% extends 'base.html.twig' %}

{% block title %}Chat · ComTSo{% endblock %}

{# The chat takes the whole viewport under the masthead: see the unlayered "page layout" block of components/_chat.scss.
   `div.page` (a direct child of <body>, holds the flash messages and this block) becomes the flex column. #}
{% block body_class %}chat-page{% endblock %}

{% block content_layout %}
    <main id="main" class="chat-main" tabindex="-1">
        <div class="chat-mount" data-vue-component="ChatRoom" data-props="{{ props|json_encode|e('html_attr') }}">
            <div class="chat-room card card-flush chat-loading">
                <noscript><p class="chat-edge">Le chat nécessite JavaScript.</p></noscript>
                <p class="chat-edge" role="status">Chargement du chat…</p>
            </div>
        </div>
    </main>
{% endblock %}

{% block footer %}{% endblock %}
