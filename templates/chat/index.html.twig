{% extends 'base.html.twig' %}

{% block title %}Chat · ComTSo{% endblock %}

{# The chat takes the whole viewport under the navbar: see the "CHAT" block of assets/styles/app.css. #}
{% block body_class %}chat-page{% endblock %}

{% block content_layout %}
    <div class="chat-mount" data-vue-component="ChatRoom" data-props="{{ props|json_encode|e('html_attr') }}">
        <div class="card flex flex-1 items-center justify-center text-sm text-muted">
            <noscript>Le chat nécessite JavaScript.</noscript>
            <span>Chargement du chat…</span>
        </div>
    </div>
{% endblock %}
