# ComTSo PRODUCTION — read by Docker Compose only (never by PHP, never baked into an image).
#
#   cp .env.example .env && chmod 600 .env     # then replace every `change-me` (see deploy/README.md)
#
# Part 1 (settings) is interpolated into deploy/compose.yaml; part 2 (secrets) becomes files under /run/secrets/
# (top-level `secrets:` of compose.yaml). Never commit the filled-in file (.gitignore covers deploy/.env).

# ---------------------------------------------------------------------------------------------------------------------
# 1. Settings
# ---------------------------------------------------------------------------------------------------------------------

# Image tag to run: `latest` (default branch), `sha-<short>` (any build) or a release `1.2.3` (git tag v1.2.3).
# Rolling back = setting this to a previous tag and running `docker compose up -d`.
COMTSO_IMAGE_TAG=latest

# Public host name (DNS must point to this server). Used for the Caddy certificate, absolute URLs and the Mercure URL.
SERVER_NAME=forum.example.com

# Open registration at /register (the forum is private; accounts are normally created with `app:user:create`).
#REGISTRATION_ENABLED=false

# Sender of the e-mails (password reset), `Name <address>`, on a domain validated in your SMTP provider (TEM: validated sender domain).
# The default `ComTSo <no-reply@localhost>` is refused by any real SMTP service: set it as soon as MAILER_DSN is real.
#MAILER_FROM="ComTSo <no-reply@example.com>"

# --- Reverse proxy options (default: none, Caddy serves HTTPS itself on 80/443) --------------------------------------
# Behind an external proxy that terminates TLS (nginx, ...): plain HTTP inside, trust its X-Forwarded-* headers.
#CADDY_SITE_ADDRESS=:80
#TRUSTED_PROXIES=private_ranges
# Do not take the host's 80/443 (bind to loopback, point the proxy to 127.0.0.1:8080):
#HTTP_BIND=127.0.0.1:8080
#HTTPS_BIND=127.0.0.1:8443
# Shared Traefik on the same Docker host: also the three lines below (override file compose.traefik.yaml, no published port needed):
#COMPOSE_FILE=compose.yaml:compose.traefik.yaml
#CERT_RESOLVER=letsencrypt          # name of your Traefik certificatesResolvers entry
#TRAEFIK_NETWORK=proxy              # shared Docker network Traefik watches

# ---------------------------------------------------------------------------------------------------------------------
# 2. Secrets (generate each one: `openssl rand -hex 32`; use hex/alphanumeric values, they end up inside a database URL)
# ---------------------------------------------------------------------------------------------------------------------

# Symfony kernel secret (CSRF tokens, remember-me). Changing it logs everybody out.
APP_SECRET=change-me-openssl-rand-hex-32

# MariaDB: password of the `comtso` application user and of root. They are applied when the database volume is first
# created; to change them later use ALTER USER inside MariaDB, then update this file.
DATABASE_PASSWORD=change-me-openssl-rand-hex-32
DATABASE_ROOT_PASSWORD=change-me-openssl-rand-hex-32

# Mercure hub JWT secret (HS256, at least 32 characters): Caddy verifies tokens with it, Symfony signs them with it.
MERCURE_JWT_SECRET=change-me-openssl-rand-hex-32

# Outgoing mail (password reset): a Symfony Mailer DSN, which holds the SMTP password. symfony/mailer speaks smtp:// natively.
# Recommended: Scaleway Transactional Email (TEM): username = the Scaleway PROJECT ID, password = the SECRET KEY of an API key
# allowed to send transactional e-mail (console > IAM > API keys). The sender domain of MAILER_FROM must be validated in the TEM
# console first (SPF + DKIM records required by TEM, MX + DMARC recommended). Port 587 = STARTTLS (465 = implicit TLS, scheme smtps://).
#MAILER_DSN=smtp://<SCW_PROJECT_ID>:<SCW_SECRET_KEY>@smtp.tem.scaleway.com:587
# `null://null` silently drops mails: reset links then never arrive (the owner can still run `app:user:reset-password`).
MAILER_DSN=null://null
