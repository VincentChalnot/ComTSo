# ComTSo development secrets — consumed by Docker Compose ONLY (never parsed by PHP, never copied into an image).
#
#   cp .env.example .env
#
# Compose turns each value into a secret file mounted under /run/secrets/ (see the `secrets:` section of compose.yaml);
# the application reads the files, not these variables. The values below are throwaway DEV values: production secrets are
# generated separately, see deploy/.env.example.
#
# Non-secret settings (SERVER_NAME, REGISTRATION_ENABLED, TRUSTED_PROXIES, DATABASE_PORT, ...) are NOT stored here:
# they live in the `environment:` blocks of compose.yaml, overridable from the shell, e.g.
#   REGISTRATION_ENABLED=true docker compose up -d

# Symfony kernel secret (CSRF tokens, remember-me, signed URLs). Changing it logs everybody out.
APP_SECRET=dev-only-app-secret-change-me-in-any-shared-environment

# MariaDB: the `comtso` user (application + PHPUnit) and root. They only apply when the database volume is first created;
# changing them afterwards requires ALTER USER (or `docker compose down -v`, which DESTROYS the dev data).
DATABASE_PASSWORD=comtso
DATABASE_ROOT_PASSWORD=root

# Mercure hub JWT secret (publisher and subscriber, HS256): Caddy verifies tokens with it, Symfony signs them with it.
MERCURE_JWT_SECRET=81ZsnGrFJHde7UV60QZ50na83joiHTueYw1WrTTtATG1q3o

# Mailer DSN (the dev `mailer` service is Mailpit). In production it embeds the SMTP password, hence a secret.
MAILER_DSN=smtp://mailer:1025
