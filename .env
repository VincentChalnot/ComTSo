# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> app ###
# The forum is private: set to true to let anybody create an account at /register.
REGISTRATION_ENABLED=false
# Reverse proxies whose X-Forwarded-* headers are trusted (the Docker `proxy` network is private-range).
TRUSTED_PROXIES=private_ranges
###< app ###

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=changeme_in_production_with_a_real_secret
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://comtso:comtso@database:3306/comtso?serverVersion=mariadb-11.4.0&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/mercure-bundle ###
MERCURE_URL=http://php/.well-known/mercure
MERCURE_PUBLIC_URL=https://comtso.local.sidus.fr/.well-known/mercure
MERCURE_JWT_SECRET="81ZsnGrFJHde7UV60QZ50na83joiHTueYw1WrTTtATG1q3o"
CADDY_MERCURE_JWT_SECRET="81ZsnGrFJHde7UV60QZ50na83joiHTueYw1WrTTtATG1q3o"
###< symfony/mercure-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=https://comtso.local.sidus.fr
###< symfony/routing ###

###> symfony/messenger ###
# Choose one of the transports below
# MESSENGER_TRANSPORT_DSN=amqp://guest:guest@localhost:5672/%2f/messages
# MESSENGER_TRANSPORT_DSN=redis://localhost:6379/messages
MESSENGER_TRANSPORT_DSN=doctrine://default?auto_setup=0
###< symfony/messenger ###

###> legacy reimport (temporary, see docs/legacy-import.md) ###
LEGACY_MYSQL_ROOT_PASSWORD=root
LEGACY_MYSQL_DATABASE=comtso_oldphp
LEGACY_PG_USER=postgres
LEGACY_PG_PASSWORD=legacy
LEGACY_PG_DATABASE=comtso2
# Read by `app:legacy:reimport` (old PHP forum + phpBB 2 tables, and phpBB 3)
LEGACY_OLDPHP_URL="mysql://root:root@legacy-mysql:3306/comtso_oldphp?serverVersion=mariadb-11.4.0&charset=utf8mb4"
LEGACY_PHPBB3_URL="pgsql://postgres:legacy@legacy-postgres:5432/comtso2?charset=utf8"
###< legacy reimport ###
